{
  "name": "wiredframe-radar-frontend",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite dev",
    "prebuild": "node -e \"const fs=require('fs'),p=require('path'),d='../web/data',b='../.data-backup',o='../web';if(fs.existsSync(b))fs.rmSync(b,{recursive:true,force:true});if(fs.existsSync(d)){fs.cpSync(d,b,{recursive:true});console.log('Backed up web/data')}fs.mkdirSync(o,{recursive:true});for(const n of fs.readdirSync(o)){if(n!=='data')fs.rmSync(p.join(o,n),{recursive:true,force:true})}console.log('Cleaned generated web output')\"",
    "build": "vite build",
    "postbuild": "node scripts/finalize-build.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/dompurify": "^3.0.0",
    "@types/node": "^20.19.43",
    "autoprefixer": "^10.5.4",
    "cheerio": "^1.2.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.26",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.0.0",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/analytics": "^2.0.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.14",
    "minisearch": "^7.1.0"
  },
  "overrides": {
    "cookie": "0.7.2"
  }
}
